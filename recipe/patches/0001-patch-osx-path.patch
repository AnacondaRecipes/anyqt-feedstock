From 8c1a6cfef84c44757b0a66ac7b4e09d5d0e98d9f Mon Sep 17 00:00:00 2001
From: Ivan Iziumov <iiziumov@anaconda.com>
Date: Mon, 3 Nov 2025 16:10:53 +0100
Subject: [PATCH] patch osx path

---
 AnyQt/_ctypes.py | 2 ++
 AnyQt/_fixes.py  | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/AnyQt/_ctypes.py b/AnyQt/_ctypes.py
index 520cd8b..e75e2bf 100644
--- a/AnyQt/_ctypes.py
+++ b/AnyQt/_ctypes.py
@@ -18,6 +18,8 @@ def find_library(name, path) -> Iterable[str]:
             "{name}.framework/Versions/Current/{name}".format(name=name),
             "{name}.framework/Versions/*/{name}".format(name=name),
             "lib{name}.dylib".format(name=name),
+            "{name}*.dylib".format(name=name),
+            "lib{name}*.dylib".format(name=name),
         ]
 
     elif sys.platform == "win32":
diff --git a/AnyQt/_fixes.py b/AnyQt/_fixes.py
index 54b1e42..eee3f9e 100644
--- a/AnyQt/_fixes.py
+++ b/AnyQt/_fixes.py
@@ -57,7 +57,7 @@ def fix_pyqt6_qtgui_qaction_menu(namespace):
         return
     import ctypes
     from ._ctypes import load_qtlib
-    qtgui = load_qtlib("QtGui")
+    qtgui = load_qtlib("Qt6Gui")
     if os.name == "posix":  # assuming gcc compatible compiler
         _QAction_setMenuObject = qtgui['_ZN7QAction13setMenuObjectEP7QObject']
         _QAction_menuObject = qtgui['_ZNK7QAction10menuObjectEv']
